{
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup",
				"hooks": [
					{
						"type": "command",
						"command": "~/.codex/hooks/session-start.sh",
						"timeout": 10
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "~/.codex/hooks/validate-project-scope.sh",
						"timeout": 5
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "~/.codex/hooks/post-edit-lint.sh",
						"timeout": 30
					}
				]
			},
			{
				"matcher": "apply_patch",
				"hooks": [
					{
						"type": "command",
						"command": "~/.codex/hooks/post-edit-lint.sh",
						"timeout": 30
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.codex/hooks/post-stop-lint.sh",
						"timeout": 60
					}
				]
			}
		]
	}
}
