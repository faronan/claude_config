{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "env": {
    "EDITOR": "code",
    "CLAUDE_CODE_TMPDIR": "/Users/toshiki.ito/.claude/tmp",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70"
  },
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "pr": "Generated with [Claude Code](https://claude.com/claude-code)"
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Skill",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(tsc *)",
      "Bash(python *)",
      "Bash(pytest *)",
      "Bash(uv *)",
      "Bash(ruff *)",
      "Bash(biome *)",
      "Bash(mise *)",
      "Bash(tree *)",
      "Bash(eza *)",
      "Bash(bat *)",
      "Bash(yq *)",
      "Bash(fzf *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(jq *)",
      "Bash(codex exec --full-auto --sandbox read-only *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh repo view *)",
      "Bash(docker logs *)",
      "Bash(docker ps *)",
      "Bash(docker inspect *)",
      "Bash(docker compose logs *)",
      "mcp__context7__*",
      "mcp__sequential-thinking__*",
      "mcp__tavily-remote-mcp__*",
      "mcp__tavily__*",
      "mcp__playwright__*"
    ],
    "deny": [
      "Bash(*| bash)",
      "Bash(*| sh)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/)",
      "Bash(rm -rf $HOME/*)",
      "Bash(rm -rf ${HOME})",
      "Bash(rm -rf ${HOME}/)",
      "Bash(rm -rf ${HOME}/*)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(chmod 777 *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(pnpm install*)",
      "Bash(yarn install*)",
      "Bash(yarn add*)",
      "Bash(pnpm add*)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(python -m pip *)",
      "Bash(python3 -m pip *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh secret *)",
      "Bash(gh variable set *)",
      "Bash(gh variable delete *)",
      "Bash(gh ssh-key add *)",
      "Bash(gh ssh-key delete *)",
      "Bash(gh gpg-key add *)",
      "Bash(gh gpg-key delete *)",
      "Bash(gh auth login *)",
      "Bash(gh auth logout *)",
      "Bash(gh pr merge *)",
      "Bash(cat .env)",
      "Bash(cat .env.*)",
      "Bash(cat *.env)",
      "Bash(cat **/.env)",
      "Bash(cat **/.env.*)",
      "Bash(head .env*)",
      "Bash(head **/.env*)",
      "Bash(tail .env*)",
      "Bash(tail **/.env*)",
      "Bash(cat *.pem)",
      "Bash(cat **/*.pem)",
      "Bash(cat *.key)",
      "Bash(cat **/*.key)",
      "Bash(cat **/secrets/**)",
      "Bash(cat **/credentials.json)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/credentials.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ],
    "ask": [
      "Bash(mkdir *)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(bash -c *)",
      "Bash(sh -c *)",
      "Bash(curl -o *)",
      "Bash(curl -O *)",
      "Bash(codex exec * --sandbox workspace-write *)",
      "Bash(codex exec * --sandbox danger-full-access *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git rebase *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git tag *)",
      "Bash(git branch -D *)",
      "Bash(docker run *)",
      "Bash(docker exec *)",
      "Bash(docker build *)",
      "Bash(docker stop *)",
      "Bash(docker kill *)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker push *)",
      "Bash(docker pull *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down *)",
      "Bash(docker compose exec *)",
      "Bash(docker system *)",
      "Bash(kubectl *)",
      "Bash(brew install *)",
      "Bash(gh pr create *)",
      "Bash(gh issue create *)",
      "Bash(gh api *)",
      "mcp__github__*"
    ],
    "defaultMode": "default"
  },
  "skillOverrides": {
    "codex-delegate": "name-only",
    "empirical-prompt-tuning": "name-only",
    "playwright-test": "name-only",
    "mcp-guidance": "name-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/validate-project-scope.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/context-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-stop-lint.sh",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-completion.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-input-required.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-edit-lint.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-compact.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cwd-changed.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.js",
    "padding": 0
  },
  "language": "japanese",
  "effortLevel": "high",
  "showThinkingSummaries": true,
  "theme": "light",
  "preferredNotifChannel": "ghostty",
  "worktree": {
    "baseRef": "head"
  },
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Never bypass explicit user confirmation requirements for git commit, git push, git merge, git rebase, git stash, dependency installation, Docker execution, destructive filesystem operations, or writes outside the current project.",
      "Never send repository contents, credentials, local configuration, or private working state to external services unless that exact destination is explicitly approved for the current task."
    ]
  }
}
