{
	"mcpServers": {
		"playwright": {
			"type": "stdio",
			"command": "npx",
			"args": ["-y", "@playwright/mcp@latest"],
			"env": {}
		},
		"db": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@bytebase/dbhub",
				"--transport",
				"stdio",
				"--readonly",
				"--dsn",
				"postgres://user:password@localhost:5432/dbname?sslmode=disable"
			],
			"env": {}
		}
	}
}
